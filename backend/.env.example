# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=LedgerPilot

# --- AI toggle: true = hardcoded mock responses, false = live Gemini API ---
USE_MOCK_AI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60

# --- PayPal (sandbox by default) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RECEIVER_EMAIL=
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=
# Set to false only for local development without a public webhook URL
PAYPAL_VERIFY_WEBHOOKS=true

# --- Risk policy / payout mandate ---
AUTO_APPROVE_RISK_THRESHOLD=20
AUTO_PAY_MAX_AMOUNT=5000

# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
FLASK_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false